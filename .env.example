# Local environment example
# Copy this file to .env if you need project-specific environment variables.

# Recommended: keep Ollama models on a large disk instead of C drive.
OLLAMA_MODELS=F:\OllamaModels

# Local service addresses used by Langchain-Chatchat.
CHATCHAT_API=http://127.0.0.1:7861
CHATCHAT_WEBUI=http://127.0.0.1:8501
